# Production Server Environment Variables Template
PORT=4000
NODE_ENV=production

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: API Secret Security for /api/scrapers/run
SCRAPER_API_SECRET=your_secret_api_key_here

# Booker Credentials (Required for Booker session auth)
BOOKER_CUSTOMER_NUMBER=your_booker_customer_number
BOOKER_USERNAME=your_booker_username
BOOKER_PASSWORD=your_booker_password

# Parfetts Credentials (Required for Parfetts auth)
PARFETTS_USERNAME=your_parfetts_username
PARFETTS_PASSWORD=your_parfetts_password

# Bestway Credentials (Required for Bestway auth)
BESTWAY_USERNAME=your_bestway_username
BESTWAY_PASSWORD=your_bestway_password

# Costco Configuration
COSTCO_SEARCH_URL=https://www.costco.co.uk/rest/v2/uk/products/search
